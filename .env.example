# Copy to .env.local and fill in real values. Never commit real secrets.

# Neon/Postgres connection strings
DATABASE_URL=
POSTGRES_URL=

# Required by NextAuth (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Bearer token required by the dev-only /seed route
SEED_SECRET=
# Optional override for the seeded demo user's password
SEED_USER_PASSWORD=
